{
  "id": "NotificationsRevisit.Announcements",
  "name": "NotificationsRevisit.Announcements",
  "version": "0.0.0",
  "allowTelemetry": true,
  "extensions": [
    {
      "name": "Announcements Bundle",
      "alias": "NotificationsRevisit.Announcements.Bundle",
      "type": "bundle",
      "js": "/App_Plugins/NotificationsRevisitAnnouncements/notifications-revisit-announcements.js"
    },
    {
      "name": "Announcements Dashboard",
      "alias": "NotificationsRevisit.Announcements.Dashboard",
      "type": "dashboard",
      "element": "/App_Plugins/NotificationsRevisitAnnouncements/announcements-dashboard.js",
      "weight": 10,
      "meta": {
        "label": "Announcements",
        "pathname": "announcements"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Content"
        },
        {
          "alias": "Umb.Condition.CurrentUser.GroupId",
          "noneOf": ["f2012e4c-d232-4bd1-8eae-4384032d97d8"]
        }
      ]
    }
  ]
}
